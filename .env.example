# EcoCompress AI Environment Configuration Example
# Copy this file to .env and configure for local deployment.
# NEVER commit the actual .env file or sensitive secrets to version control.

# Application Environment
NODE_ENV=development
PORT=3000

# Backend API Configuration
API_PORT=8000
API_HOST=127.0.0.1
API_URL=http://127.0.0.1:8000

# Storage & Directory Locations (Must be placed on D: to prevent C: exhaustion)
ECOCOMPRESS_DATA_DIR=D:/Projects/Compression AI/data
ECOCOMPRESS_ARTIFACTS_DIR=D:/Projects/Compression AI/artifacts
ECOCOMPRESS_CACHE_DIR=D:/cache

# Cache Paths for AI & Python Tools
HF_HOME=D:/cache/huggingface
TORCH_HOME=D:/cache/torch
PIP_CACHE_DIR=D:/cache/pip
UV_CACHE_DIR=D:/cache/uv

# Execution Safety Limits
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=1800
DEFAULT_MEMORY_BUDGET_MB=3072
